# Copy this file to infra/lab.env and fill in your values.
# infra/lab.env is git-ignored, so your real account ID never gets committed.

LAB_ACCOUNT_ID=123456789012      # your 12-digit lab account ID (required)
LAB_REGION=ap-southeast-2        # the Region your project lives in

# Optional overrides (the defaults are shown)
# TRAIL_NAME=detlab-trail
# QUEUE_NAME=detlab-cloudtrail-events
# BUCKET_PREFIX=detlab-cloudtrail
# QUEUE_RETENTION_SECONDS=1209600
